{
	"$schema": "node_modules/wrangler/config-schema.json",
	// 公開サイト(blog.ochanu.co)を配信するアセットのみの Worker。
	// dist-static/ は scripts/generate-static.sh が生成する。
	"name": "ochanuco-blog-static",
	"account_id": "0f0afc29667897a1a5452c6e36859467",
	"compatibility_date": "2026-03-29",
	"workers_dev": false,
	"routes": [
		{
			"pattern": "blog.ochanu.co",
			"custom_domain": true
		}
	],
	"assets": {
		"directory": "./dist-static",
		"not_found_handling": "404-page"
	}
}
