---
import { getMenu, getSiteSettings } from "emdash";
import {
	WidgetArea,
	EmDashHead,
	EmDashBodyStart,
	EmDashBodyEnd,
} from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import "../styles/theme.css";
import { FALLBACK_SITE_TITLE } from "../constants/site";

interface Props {
	title: string;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	robots?: string | null;
	type?: "website" | "article";
	publishedTime?: string | null;
	modifiedTime?: string | null;
	author?: string | null;
	/** Pass content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
}

const {
	title,
	description,
	image,
	canonical,
	robots,
	type = "website",
	publishedTime,
	modifiedTime,
	author,
	content,
} = Astro.props;
const settings = await getSiteSettings();
const siteTitle = settings.title || FALLBACK_SITE_TITLE;
const faviconUrl =
	settings.favicon &&
	typeof settings.favicon === "object" &&
	"url" in settings.favicon &&
	typeof settings.favicon.url === "string"
		? settings.favicon.url
		: undefined;
// If title already includes site title (from getSeoMeta), use as-is
const fullTitle = title.includes(siteTitle) ? title : `${title} — ${siteTitle}`;

// Build public page context for plugin contributions
// SEO data is passed here and rendered securely by EmDashHead
const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: type,
	title: fullTitle,
	description,
	canonical,
	image,
	content,
	seo: { ogImage: image, robots },
	articleMeta: { publishedTime, modifiedTime, author },
	siteName: siteTitle,
});

// Check if user is logged in (for showing admin link)
const isLoggedIn = !!Astro.locals.user;

// Primary menu (admin-managed). "/" is redundant with the ~/ home link.
const menu = await getMenu("primary");
const menuItems = (menu?.items ?? []).filter((item) => item.url !== "/");
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Klee+One:wght@400;600&display=swap"
			rel="stylesheet"
		/>
		{faviconUrl && <link rel="icon" href={faviconUrl} />}
		<title>{fullTitle}</title>
		<EmDashHead page={pageCtx} />
		<script is:inline>
			// Apply theme immediately to prevent flash
			(function () {
				var c = document.cookie;
				var i = c.indexOf("theme=");
				var theme = i >= 0 ? c.slice(i + 6).split(";")[0] : null;
				if (theme === "dark" || theme === "light") {
					document.documentElement.classList.add(theme);
				} else if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
					document.documentElement.classList.add("dark");
				}
			})();
		</script>
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />
		<header class="notebook-head">
			<a href="/" class="home-link">~/{siteTitle}</a>
			<nav class="head-nav">
				{
					menuItems.map((item) => (
						<a href={item.url} target={item.target}>
							{item.label}
						</a>
					))
				}
				<a href="/search">search</a>
				<a href="/rss.xml">rss</a>
				{
					isLoggedIn && (
						<a href="/_emdash/admin" class="head-admin">
							admin
						</a>
					)
				}
				<button
					type="button"
					class="theme-toggle"
					id="status-theme-toggle"
					aria-label="テーマ切り替え"
				>
					◐ auto
				</button>
			</nav>
		</header>

		<main>
			<slot />
		</main>

		<footer class="foot">
			<WidgetArea name="footer" />
			<p class="foot-line">
				ochanu.co — built on EmDash / Astro / Cloudflare Workers · © {
					new Date().getFullYear()
				} ochanuco · <a href="/rss.xml">rss</a>
			</p>
		</footer>

		<script>
			// Theme toggle — cycles auto -> light -> dark -> auto, cookie-backed
			// (same cookie/class mechanism as before, just a single button now).
			const THEME_REGEX = /theme=([^;]+)/;
			const root = document.documentElement;
			const toggleBtn = document.getElementById(
				"status-theme-toggle"
			) as HTMLButtonElement | null;

			const THEME_ORDER = ["system", "light", "dark"] as const;
			type Theme = (typeof THEME_ORDER)[number];
			const THEME_LABEL: Record<Theme, string> = {
				system: "◐ auto",
				light: "◐ light",
				dark: "◐ dark",
			};

			function setCookie(
				name: string,
				value: string,
				maxAge: number = 31536000
			) {
				const secure = location.protocol === "https:" ? "; Secure" : "";
				if (value === "") {
					document.cookie = `${name}=; path=/; max-age=0; SameSite=Lax${secure}`;
				} else {
					document.cookie = `${name}=${value}; path=/; max-age=${maxAge}; SameSite=Lax${secure}`;
				}
			}

			function getStoredTheme(): Theme {
				const match = document.cookie.match(THEME_REGEX);
				const value = match ? match[1] : "";
				return value === "light" || value === "dark" ? value : "system";
			}

			function applyTheme(theme: Theme) {
				if (theme === "system") {
					setCookie("theme", "");
					root.classList.remove("light", "dark");
					if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
						root.classList.add("dark");
					}
				} else {
					setCookie("theme", theme);
					root.classList.remove("light", "dark");
					root.classList.add(theme);
				}
				if (toggleBtn) toggleBtn.textContent = THEME_LABEL[theme];
			}

			// Initialize label to match the theme the anti-flash script already applied
			applyTheme(getStoredTheme());

			toggleBtn?.addEventListener("click", () => {
				const current = getStoredTheme();
				const next =
					THEME_ORDER[(THEME_ORDER.indexOf(current) + 1) % THEME_ORDER.length];
				applyTheme(next);
			});

			// Listen for system preference changes
			window
				.matchMedia("(prefers-color-scheme: dark)")
				.addEventListener("change", (e) => {
					if (getStoredTheme() === "system") {
						root.classList.toggle("dark", e.matches);
					}
				});
		</script>

		<style is:global>
			*:where(:not([class*="emdash"]):not([class*="ec-"])),
			*:where(:not([class*="emdash"]):not([class*="ec-"]))::before,
			*:where(:not([class*="emdash"]):not([class*="ec-"]))::after {
				box-sizing: border-box;
			}

			body,
			h1,
			h2,
			h3,
			h4,
			h5,
			h6,
			p,
			ul,
			ol,
			figure,
			blockquote,
			dl,
			dd {
				margin: 0;
			}

			ul,
			ol {
				padding: 0;
			}

			:root {
				/* Colors — "engineer's notebook": graph-paper ground, red-pen
				   accent for year markers, a highlighter-yellow wash for the
				   latest entry. */
				--color-paper: #fafbf8;
				--color-grid: #e3ebf1;
				--color-rule: #c2d0dc;
				--color-ink: #2a2c30;
				--color-muted: #8b95a1;
				--color-red: #d94f43;
				--color-hl: rgba(255, 222, 74, 0.5);
				--tape-bg: rgba(228, 213, 160, 0.55);
				--tape-ink: #6d6450;

				/* Legacy color aliases — kept so components that predate this
				   redesign (e.g. src/pages/pages/[slug].astro, which is out of
				   scope for this pass) keep rendering sensibly instead of
				   falling back to unstyled defaults. */
				--color-bg: var(--color-paper);
				--color-bg-subtle: var(--color-paper);
				--color-text: var(--color-ink);
				--color-text-secondary: var(--color-ink);
				--color-border: var(--color-rule);
				--color-border-subtle: var(--color-grid);
				--color-surface: var(--color-paper);
				--color-accent: var(--color-red);
				--color-accent-hover: var(--color-red);
				--color-on-accent: #ffffff;
				--color-accent-ring: color-mix(
					in srgb,
					var(--color-red) 25%,
					transparent
				);
				--led-tech: var(--color-red);
				--led-life: var(--color-red);
				--led-life-ink: var(--color-red);
				--color-panel: var(--color-paper);
				--color-panel-2: var(--color-paper);
				--color-line: var(--color-rule);
				--color-line-strong: var(--color-rule);
				--color-ink-soft: var(--color-ink);
				--color-accent-ink: var(--color-red);

				/* Typography — handwritten Japanese face applied site-wide. */
				--font-hand:
					"Klee One", "Klee", "Tsukushi A Round Gothic",
					"Hiragino Maru Gothic ProN", sans-serif;
				--font-sans: var(--font-hand);
				--font-mono: ui-monospace, SFMono-Regular, Menlo, monospace;

				/* Type scale - more refined */
				--font-size-xs: 0.8125rem;
				--font-size-sm: 0.875rem;
				--font-size-base: 1rem;
				--font-size-lg: 1.125rem;
				--font-size-xl: 1.25rem;
				--font-size-2xl: 1.5rem;
				--font-size-3xl: 2rem;
				--font-size-4xl: 2.5rem;
				--font-size-5xl: 3.5rem;

				/* Line heights */
				--leading-tight: 1.15;
				--leading-snug: 1.3;
				--leading-normal: 1.5;
				--leading-relaxed: 1.7;

				/* Spacing - more generous */
				--spacing-1: 0.25rem;
				--spacing-2: 0.5rem;
				--spacing-3: 0.75rem;
				--spacing-4: 1rem;
				--spacing-5: 1.25rem;
				--spacing-6: 1.5rem;
				--spacing-8: 2rem;
				--spacing-10: 2.5rem;
				--spacing-12: 3rem;
				--spacing-16: 4rem;
				--spacing-20: 5rem;
				--spacing-24: 6rem;

				/* Legacy spacing aliases */
				--spacing-xs: var(--spacing-1);
				--spacing-sm: var(--spacing-2);
				--spacing-md: var(--spacing-4);
				--spacing-lg: var(--spacing-6);
				--spacing-xl: var(--spacing-8);
				--spacing-2xl: var(--spacing-12);
				--spacing-3xl: var(--spacing-16);

				/* Layout - wider for three-column */
				--content-width: 680px;
				--wide-width: 1200px;
				--max-width: var(--content-width);
				--gutter-width: 200px;
				--radius: 4px;
				--radius-lg: 8px;

				/* Transitions */
				--transition-fast: 120ms ease;
				--transition-base: 180ms ease;

				/* Nav */
				--nav-height: 53px;

				/* Search */
				--search-input-width: 180px;

				/* Article layout */
				--meta-col-width: 180px;

				/* Avatar sizes */
				--avatar-size-xs: 18px;
				--avatar-size-sm: 20px;
				--avatar-size-md: 24px;
				--avatar-size-lg: 32px;

				/* Letter spacing */
				--tracking-tight: -0.03em;
				--tracking-snug: -0.02em;
				--tracking-wide: 0.06em;
				--tracking-wider: 0.08em;

				/* Tag pill */
				--tag-padding-y: 2px;

				/* Shadows */
				--shadow-dropdown: 0 8px 30px rgba(0, 0, 0, 0.12);
				--shadow-btn-active: 0 1px 2px rgba(0, 0, 0, 0.05);
				--shadow-card:
					0 1px 2px rgba(20, 30, 45, 0.06), 0 8px 24px rgba(20, 30, 45, 0.06);
			}

			/* Dark mode via system preference (when no explicit class) */
			@media (prefers-color-scheme: dark) {
				:root:not(.light) {
					--color-paper: #1d2025;
					--color-grid: rgba(125, 145, 165, 0.13);
					--color-rule: #3a4450;
					--color-ink: #d6dae0;
					--color-muted: #7f8a97;
					--color-red: #e07a6e;
					--color-hl: rgba(255, 222, 74, 0.26);
					--tape-bg: rgba(190, 175, 120, 0.22);
					--tape-ink: #b8ab84;
					--shadow-card:
						0 1px 2px rgba(0, 0, 0, 0.3), 0 10px 30px rgba(0, 0, 0, 0.28);
				}
			}

			/* Explicit dark mode */
			:root.dark {
				--color-paper: #1d2025;
				--color-grid: rgba(125, 145, 165, 0.13);
				--color-rule: #3a4450;
				--color-ink: #d6dae0;
				--color-muted: #7f8a97;
				--color-red: #e07a6e;
				--color-hl: rgba(255, 222, 74, 0.26);
				--tape-bg: rgba(190, 175, 120, 0.22);
				--tape-ink: #b8ab84;
				--shadow-card:
					0 1px 2px rgba(0, 0, 0, 0.3), 0 10px 30px rgba(0, 0, 0, 0.28);
			}

			html {
				scroll-behavior: smooth;
			}

			body {
				font-family: var(--font-hand);
				font-size: var(--font-size-base);
				line-height: var(--leading-relaxed);
				color: var(--color-ink);
				min-height: 100vh;
				-webkit-font-smoothing: antialiased;
				-moz-osx-font-smoothing: grayscale;
				background:
					repeating-linear-gradient(
						to bottom,
						transparent 0 19px,
						var(--color-grid) 19px 20px
					),
					repeating-linear-gradient(
						to right,
						transparent 0 19px,
						var(--color-grid) 19px 20px
					),
					var(--color-paper);
			}

			a:where(:not([class*="emdash"]):not([class*="ec-"])) {
				color: var(--color-red);
				text-decoration: none;
				transition: color var(--transition-fast);
			}

			a:where(:not([class*="emdash"]):not([class*="ec-"])):hover {
				color: var(--color-red);
				text-decoration: underline;
			}

			img {
				max-width: 100%;
				height: auto;
				display: block;
			}

			h1,
			h2,
			h3,
			h4,
			h5,
			h6 {
				font-family: var(--font-hand);
				line-height: var(--leading-tight);
				font-weight: 600;
				letter-spacing: var(--tracking-snug);
			}

			h1 {
				font-weight: 700;
				letter-spacing: var(--tracking-tight);
			}

			::selection {
				background: var(--color-red);
				color: white;
			}
		</style>

		<!-- Notebook design system — shared across every page: the masking-tape
		     label, the ruled/grid article-list sheet, its .row entries, the
		     corner wiring doodle, and the common hand-drawn border radius.
		     Lives here as global CSS instead of being duplicated per page. -->
		<style is:global>
			.tape {
				display: inline-block;
				font-family: var(--font-hand);
				font-size: 12px;
				letter-spacing: 0.16em;
				color: var(--tape-ink);
				background: var(--tape-bg);
				padding: 3px 20px;
				transform: rotate(-1.6deg);
				margin-bottom: 14px;
				box-shadow: 0 1px 2px rgb(0 0 0 / 0.08);
			}

			.hand-box {
				border-radius: 9px 13px 8px 14px / 14px 8px 13px 9px;
			}

			.sheet {
				/* Grid + a vertical rule marking off the date margin column. */
				background:
					linear-gradient(
						to right,
						transparent 0 103px,
						var(--color-rule) 103px 104px,
						transparent 104px
					),
					repeating-linear-gradient(
						to bottom,
						transparent 0 19px,
						var(--color-grid) 19px 20px
					),
					repeating-linear-gradient(
						to right,
						transparent 0 19px,
						var(--color-grid) 19px 20px
					);
				border-top: 1.5px solid var(--color-rule);
			}

			.row {
				display: flex;
				align-items: baseline;
				line-height: 40px;
				min-height: 40px;
			}

			.row .margin {
				flex: none;
				width: 104px;
				padding-right: 16px;
				box-sizing: border-box;
				text-align: right;
				font-size: 12.5px;
				color: var(--color-muted);
				font-variant-numeric: tabular-nums;
			}

			.row .margin.year {
				color: var(--color-red);
				font-size: 13px;
				font-weight: 600;
				letter-spacing: 0.06em;
			}

			.row .body {
				flex: 1;
				padding-left: 14px;
				font-size: 15.5px;
				min-width: 0;
			}

			.row .body a {
				color: inherit;
				text-decoration: none;
			}

			.row .body a:hover {
				text-decoration: underline;
				text-decoration-color: var(--color-red);
				text-underline-offset: 5px;
			}

			.row.latest .body a {
				font-weight: 600;
				/* Highlighter-pen wash */
				background: linear-gradient(
					transparent 18%,
					var(--color-hl) 18% 92%,
					transparent 92%
				);
			}

			.row.blank {
				min-height: 20px;
			}

			.row .cat {
				font-size: 12px;
				color: var(--color-muted);
				margin-left: 10px;
			}

			.doodle {
				display: flex;
				align-items: center;
				gap: 8px;
				font-size: 11px;
				color: var(--color-muted);
				transform: rotate(-1.2deg);
			}

			.doodle .box {
				border: 1.5px solid var(--color-muted);
				border-radius: 7px 10px 6px 11px / 11px 6px 10px 7px;
				padding: 3px 10px;
			}

			.doodle .wire {
				width: 30px;
				text-align: center;
				letter-spacing: -0.05em;
			}

			@media (max-width: 640px) {
				.sheet {
					background:
						linear-gradient(
							to right,
							transparent 0 71px,
							var(--color-rule) 71px 72px,
							transparent 72px
						),
						repeating-linear-gradient(
							to bottom,
							transparent 0 19px,
							var(--color-grid) 19px 20px
						),
						repeating-linear-gradient(
							to right,
							transparent 0 19px,
							var(--color-grid) 19px 20px
						);
				}

				.row .margin {
					width: 72px;
					padding-right: 10px;
				}
			}
		</style>

		<style>
			.notebook-head {
				position: sticky;
				top: 0;
				z-index: 100;
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 16px;
				padding: 14px clamp(16px, 4vw, 40px);
				background: color-mix(in srgb, var(--color-paper) 88%, transparent);
				backdrop-filter: blur(6px);
				-webkit-backdrop-filter: blur(6px);
				border-bottom: 1px solid var(--color-rule);
				font-family: var(--font-hand);
				font-size: 14px;
			}

			.home-link {
				color: var(--color-ink);
				text-decoration: none;
				font-weight: 600;
				letter-spacing: 0.01em;
			}

			.home-link:hover {
				color: var(--color-red);
				text-decoration: none;
			}

			.head-nav {
				display: flex;
				align-items: center;
				gap: 18px;
				flex-wrap: wrap;
			}

			.head-nav a {
				color: var(--color-muted);
				text-decoration: none;
				text-transform: lowercase;
			}

			.head-nav a:hover {
				color: var(--color-red);
				text-decoration: none;
			}

			.head-admin {
				color: var(--color-muted);
			}

			.theme-toggle {
				font-family: var(--font-hand);
				font-size: 13px;
				color: var(--color-muted);
				background: transparent;
				border: none;
				cursor: pointer;
				padding: 0;
			}

			.theme-toggle:hover {
				color: var(--color-red);
			}

			.theme-toggle:focus-visible {
				outline: 2px solid var(--color-red);
				outline-offset: 2px;
			}

			main {
				min-height: calc(100vh - var(--nav-height) - 260px);
			}

			/* Footer(本文と同じく左寄せ) */
			.foot {
				max-width: 760px;
				margin: 0;
				padding: var(--spacing-12) clamp(16px, 4vw, 40px) var(--spacing-12);
			}

			.foot-line {
				font-family: var(--font-hand);
				font-size: 12px;
				color: var(--color-muted);
			}

			.foot-line a {
				color: var(--color-muted);
				text-decoration: underline;
				text-underline-offset: 2px;
			}

			.foot-line a:hover {
				color: var(--color-red);
			}

			.foot :global(.widget-area) {
				margin-bottom: var(--spacing-6);
			}

			@media (max-width: 640px) {
				.notebook-head {
					flex-wrap: wrap;
					row-gap: 8px;
				}
			}
		</style>

		<script>
			// ⌘K / Ctrl+K navigates to the search page (there's no inline search
			// input in the header anymore).
			document.addEventListener("keydown", (e) => {
				if ((e.metaKey || e.ctrlKey) && e.key === "k") {
					const target = e.target;
					if (
						target instanceof HTMLElement &&
						(target.matches("input, textarea, select") ||
							target.isContentEditable)
					) {
						return;
					}
					e.preventDefault();
					window.location.assign("/search");
				}
			});
		</script>
		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
