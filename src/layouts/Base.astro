---
import { getMenu, getSiteSettings } from "emdash";
import {
	WidgetArea,
	EmDashHead,
	EmDashBodyStart,
	EmDashBodyEnd,
} from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import "../styles/theme.css";
import { FALLBACK_SITE_TITLE } from "../constants/site";

interface Props {
	title: string;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	robots?: string | null;
	type?: "website" | "article";
	publishedTime?: string | null;
	modifiedTime?: string | null;
	author?: string | null;
	/** Pass content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
}

const {
	title,
	description,
	image,
	canonical,
	robots,
	type = "website",
	publishedTime,
	modifiedTime,
	author,
	content,
} = Astro.props;
const settings = await getSiteSettings();
const siteTitle = settings.title || FALLBACK_SITE_TITLE;
const faviconUrl =
	settings.favicon &&
	typeof settings.favicon === "object" &&
	"url" in settings.favicon &&
	typeof settings.favicon.url === "string"
		? settings.favicon.url
		: undefined;
// If title already includes site title (from getSeoMeta), use as-is
const fullTitle = title.includes(siteTitle) ? title : `${title} — ${siteTitle}`;

// Fetch primary menu defined in seed
const menu = await getMenu("primary");

// Build public page context for plugin contributions
// SEO data is passed here and rendered securely by EmDashHead
const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: type,
	title: fullTitle,
	description,
	canonical,
	image,
	content,
	seo: { ogImage: image, robots },
	articleMeta: { publishedTime, modifiedTime, author },
	siteName: siteTitle,
});

// Check if user is logged in (for showing admin link)
const isLoggedIn = !!Astro.locals.user;
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700&family=JetBrains+Mono:wght@400;500&display=swap"
			rel="stylesheet"
		/>
		{faviconUrl && <link rel="icon" href={faviconUrl} />}
		<title>{fullTitle}</title>
		<EmDashHead page={pageCtx} />
		<script is:inline>
			// Apply theme immediately to prevent flash
			(function () {
				var c = document.cookie;
				var i = c.indexOf("theme=");
				var theme = i >= 0 ? c.slice(i + 6).split(";")[0] : null;
				if (theme === "dark" || theme === "light") {
					document.documentElement.classList.add(theme);
				} else if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
					document.documentElement.classList.add("dark");
				}
			})();
		</script>
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />
		<header class="statusbar">
			<a href="/" class="host">
				<span class="led" aria-hidden="true"></span>
				<span class="prompt">~/</span><span class="name">{siteTitle}</span>
			</a>
			<nav class="status-nav">
				{
					menu?.items.map((item) => (
						<a href={item.url} target={item.target}>
							{item.label}
						</a>
					))
				}
				<a href="/search">/search</a>
				{
					isLoggedIn && (
						<a href="/_emdash/admin" class="status-admin">
							admin
						</a>
					)
				}
			</nav>
			<span class="spacer"></span>
			<span class="clock" id="status-clock"></span>
			<button
				type="button"
				class="theme-toggle"
				id="status-theme-toggle"
				aria-label="テーマ切り替え"
			>
				◐ auto
			</button>
		</header>

		<main>
			<slot />
		</main>

		<footer class="foot">
			<WidgetArea name="footer" />
			<div class="bar"></div>
			ochanu.co — built on EmDash / Astro / Cloudflare Workers · © {
				new Date().getFullYear()
			} ochanuco · <a href="/rss.xml">rss</a>
		</footer>

		<script>
			// Theme toggle — cycles auto -> light -> dark -> auto, cookie-backed
			// (same cookie/class mechanism as before, just a single button now).
			const THEME_REGEX = /theme=([^;]+)/;
			const root = document.documentElement;
			const toggleBtn = document.getElementById(
				"status-theme-toggle"
			) as HTMLButtonElement | null;

			const THEME_ORDER = ["system", "light", "dark"] as const;
			type Theme = (typeof THEME_ORDER)[number];
			const THEME_LABEL: Record<Theme, string> = {
				system: "◐ auto",
				light: "◐ light",
				dark: "◐ dark",
			};

			function setCookie(
				name: string,
				value: string,
				maxAge: number = 31536000
			) {
				const secure = location.protocol === "https:" ? "; Secure" : "";
				if (value === "") {
					document.cookie = `${name}=; path=/; max-age=0; SameSite=Lax${secure}`;
				} else {
					document.cookie = `${name}=${value}; path=/; max-age=${maxAge}; SameSite=Lax${secure}`;
				}
			}

			function getStoredTheme(): Theme {
				const match = document.cookie.match(THEME_REGEX);
				const value = match ? match[1] : "";
				return value === "light" || value === "dark" ? value : "system";
			}

			function applyTheme(theme: Theme) {
				if (theme === "system") {
					setCookie("theme", "");
					root.classList.remove("light", "dark");
					if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
						root.classList.add("dark");
					}
				} else {
					setCookie("theme", theme);
					root.classList.remove("light", "dark");
					root.classList.add(theme);
				}
				if (toggleBtn) toggleBtn.textContent = THEME_LABEL[theme];
			}

			// Initialize label to match the theme the anti-flash script already applied
			applyTheme(getStoredTheme());

			toggleBtn?.addEventListener("click", () => {
				const current = getStoredTheme();
				const next =
					THEME_ORDER[(THEME_ORDER.indexOf(current) + 1) % THEME_ORDER.length];
				applyTheme(next);
			});

			// Listen for system preference changes
			window
				.matchMedia("(prefers-color-scheme: dark)")
				.addEventListener("change", (e) => {
					if (getStoredTheme() === "system") {
						root.classList.toggle("dark", e.matches);
					}
				});
		</script>

		<script>
			// JST clock — rendered client-side only, never baked into SSR/static
			// output, since this site is crawled and frozen for static delivery.
			const clockEl = document.getElementById("status-clock");

			const CLOCK_PARTS: Intl.DateTimeFormatOptions = {
				timeZone: "Asia/Tokyo",
				year: "numeric",
				month: "2-digit",
				day: "2-digit",
				hour: "2-digit",
				minute: "2-digit",
				hour12: false,
			};

			function renderClock() {
				if (!clockEl) return;
				const parts = new Intl.DateTimeFormat("en-US", CLOCK_PARTS).formatToParts(
					new Date()
				);
				const get = (type: Intl.DateTimeFormatPartTypes) =>
					parts.find((p) => p.type === type)?.value ?? "";
				const formatted = `${get("year")}-${get("month")}-${get("day")} ${get("hour")}:${get("minute")}`;
				clockEl.innerHTML = `<b>JST</b> ${formatted}`;
			}

			renderClock();
			setInterval(renderClock, 30000);
		</script>

		<style is:global>
			*:where(:not([class*="emdash"]):not([class*="ec-"])),
			*:where(:not([class*="emdash"]):not([class*="ec-"]))::before,
			*:where(:not([class*="emdash"]):not([class*="ec-"]))::after {
				box-sizing: border-box;
			}

			body,
			h1,
			h2,
			h3,
			h4,
			h5,
			h6,
			p,
			ul,
			ol,
			figure,
			blockquote,
			dl,
			dd {
				margin: 0;
			}

			ul,
			ol {
				padding: 0;
			}

			:root {
				/* Colors - Light mode (default)
				   "phosphor + water" — cool ink ground, teal accent that reads
				   as both terminal glow and aquarium water. */
				--color-bg: #eef1f4;
				--color-bg-subtle: #e9edf1;
				--color-text: #18202a;
				--color-text-secondary: #3d4856;
				--color-muted: #63707f;
				--color-border: #dbe2e9;
				--color-border-subtle: #e8ecf1;
				--color-surface: #ffffff;
				--color-accent: #0f8a7d;
				--color-accent-hover: #0b6f64;
				--color-on-accent: #ffffff;
				--color-accent-ring: color-mix(
					in srgb,
					var(--color-accent) 25%,
					transparent
				);

				/* Category LEDs — teal for tinkering (infra/aquarium),
				   amber for life events. Semantic, separate from the accent. */
				--led-tech: var(--color-accent);
				--led-life: #b9781a;
				/* Darker ink for life-tag text — the LED amber alone is ~3:1 on
				   the translucent chip background in light mode. */
				--led-life-ink: #83510d;
				--led-life-dim: color-mix(in srgb, var(--led-life) 14%, transparent);
				--accent-dim: color-mix(in srgb, var(--color-accent) 12%, transparent);

				/* "Uptime log" redesign tokens — panels, hairlines, and the
				   secondary ink tone used by the statusbar/feed/rail system.
				   Kept distinct from --color-surface/--color-border/
				   --color-text-secondary so the legacy card components above
				   are unaffected. */
				--color-panel: #ffffff;
				--color-panel-2: #f6f8fa;
				--color-line: #dce2e9;
				--color-line-strong: #c6cfda;
				--color-ink-soft: #3c4757;
				--color-accent-ink: #0a6d63;
				--shadow-card:
					0 1px 2px rgba(20, 30, 45, 0.06), 0 8px 24px rgba(20, 30, 45, 0.06);

				/* Typography */
				--font-sans:
					"Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
					sans-serif;
				--font-mono:
					"JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;

				/* Type scale - more refined */
				--font-size-xs: 0.8125rem;
				--font-size-sm: 0.875rem;
				--font-size-base: 1rem;
				--font-size-lg: 1.125rem;
				--font-size-xl: 1.25rem;
				--font-size-2xl: 1.5rem;
				--font-size-3xl: 2rem;
				--font-size-4xl: 2.5rem;
				--font-size-5xl: 3.5rem;

				/* Line heights */
				--leading-tight: 1.15;
				--leading-snug: 1.3;
				--leading-normal: 1.5;
				--leading-relaxed: 1.7;

				/* Spacing - more generous */
				--spacing-1: 0.25rem;
				--spacing-2: 0.5rem;
				--spacing-3: 0.75rem;
				--spacing-4: 1rem;
				--spacing-5: 1.25rem;
				--spacing-6: 1.5rem;
				--spacing-8: 2rem;
				--spacing-10: 2.5rem;
				--spacing-12: 3rem;
				--spacing-16: 4rem;
				--spacing-20: 5rem;
				--spacing-24: 6rem;

				/* Legacy spacing aliases */
				--spacing-xs: var(--spacing-1);
				--spacing-sm: var(--spacing-2);
				--spacing-md: var(--spacing-4);
				--spacing-lg: var(--spacing-6);
				--spacing-xl: var(--spacing-8);
				--spacing-2xl: var(--spacing-12);
				--spacing-3xl: var(--spacing-16);

				/* Layout - wider for three-column */
				--content-width: 680px;
				--wide-width: 1200px;
				--max-width: var(--content-width);
				--gutter-width: 200px;
				--radius: 4px;
				--radius-lg: 8px;

				/* Transitions */
				--transition-fast: 120ms ease;
				--transition-base: 180ms ease;

				/* Nav */
				--nav-height: 64px;

				/* Search */
				--search-input-width: 180px;

				/* Article layout */
				--meta-col-width: 180px;

				/* Avatar sizes */
				--avatar-size-xs: 18px;
				--avatar-size-sm: 20px;
				--avatar-size-md: 24px;
				--avatar-size-lg: 32px;

				/* Letter spacing */
				--tracking-tight: -0.03em;
				--tracking-snug: -0.02em;
				--tracking-wide: 0.06em;
				--tracking-wider: 0.08em;

				/* Tag pill */
				--tag-padding-y: 2px;

				/* Shadows */
				--shadow-dropdown: 0 8px 30px rgba(0, 0, 0, 0.12);
				--shadow-btn-active: 0 1px 2px rgba(0, 0, 0, 0.05);
			}

			/* Dark mode via system preference (when no explicit class) */
			@media (prefers-color-scheme: dark) {
				:root:not(.light) {
					--color-bg: #0e1319;
					--color-bg-subtle: #0b0f14;
					--color-text: #d8dfe8;
					--color-text-secondary: #aeb9c6;
					--color-muted: #7e8b9b;
					--color-border: #232d39;
					--color-border-subtle: #1b2530;
					--color-surface: #161d26;
					--color-accent: #4fd6c4;
					--color-accent-hover: #7ee6d8;
					--led-life: #e0a24a;
					--led-life-ink: var(--led-life);

					--color-panel: #161d26;
					--color-panel-2: #1b232e;
					--color-line: #232d39;
					--color-line-strong: #303c4b;
					--color-ink-soft: #aeb9c6;
					--color-accent-ink: #7ee6d8;
					--shadow-card:
						0 1px 2px rgba(0, 0, 0, 0.3), 0 10px 30px rgba(0, 0, 0, 0.28);
				}
			}

			/* Explicit dark mode */
			:root.dark {
				--color-bg: #0e1319;
				--color-bg-subtle: #0b0f14;
				--color-text: #d8dfe8;
				--color-text-secondary: #aeb9c6;
				--color-muted: #7e8b9b;
				--color-border: #232d39;
				--color-border-subtle: #1b2530;
				--color-surface: #161d26;
				--color-accent: #4fd6c4;
				--color-accent-hover: #7ee6d8;
				--led-life: #e0a24a;
				--led-life-ink: var(--led-life);

				--color-panel: #161d26;
				--color-panel-2: #1b232e;
				--color-line: #232d39;
				--color-line-strong: #303c4b;
				--color-ink-soft: #aeb9c6;
				--color-accent-ink: #7ee6d8;
				--shadow-card:
					0 1px 2px rgba(0, 0, 0, 0.3), 0 10px 30px rgba(0, 0, 0, 0.28);
			}

			html {
				scroll-behavior: smooth;
			}

			body {
				font-family: var(--font-sans);
				font-size: var(--font-size-base);
				line-height: var(--leading-relaxed);
				color: var(--color-text);
				background: var(--color-bg);
				-webkit-font-smoothing: antialiased;
				-moz-osx-font-smoothing: grayscale;
				min-height: 100vh;
			}

			a:where(:not([class*="emdash"]):not([class*="ec-"])) {
				color: var(--color-accent);
				text-decoration: none;
				transition: color var(--transition-fast);
			}

			a:where(:not([class*="emdash"]):not([class*="ec-"])):hover {
				color: var(--color-accent-hover);
			}

			img {
				max-width: 100%;
				height: auto;
				display: block;
			}

			h1,
			h2,
			h3,
			h4,
			h5,
			h6 {
				font-family: var(--font-sans);
				line-height: var(--leading-tight);
				font-weight: 600;
				letter-spacing: var(--tracking-snug);
			}

			h1 {
				font-weight: 700;
				letter-spacing: var(--tracking-tight);
			}

			::selection {
				background: var(--color-accent);
				color: white;
			}
		</style>

		<!-- "Uptime log" design system: shared across index.astro, posts/index.astro,
		     and LogEntry.astro, so it lives here as global CSS instead of being
		     duplicated in every page that renders a log feed. -->
		<style is:global>
			.sec-label {
				font-family: var(--font-mono);
				font-size: 12px;
				letter-spacing: 0.1em;
				text-transform: uppercase;
				color: var(--color-muted);
				display: flex;
				align-items: baseline;
				gap: 10px;
				margin: 0 0 var(--spacing-4);
			}

			.sec-label::after {
				content: "";
				flex: 1;
				height: 1px;
				background: var(--color-line);
				transform: translateY(-3px);
			}

			.sec-label .count {
				color: var(--color-ink-soft);
			}

			.dot {
				width: 7px;
				height: 7px;
				border-radius: 50%;
				flex: none;
			}

			.dot.tech {
				background: var(--color-accent);
			}

			.dot.life {
				background: var(--led-life);
			}

			.tag {
				font-family: var(--font-mono);
				font-size: 11.5px;
				padding: 2px 8px;
				border-radius: 5px;
				border: 1px solid var(--color-line-strong);
				color: var(--color-muted);
				white-space: nowrap;
				text-decoration: none;
				transition:
					color var(--transition-fast),
					border-color var(--transition-fast);
			}

			.tag.tech {
				color: var(--color-accent-ink);
				border-color: color-mix(
					in srgb,
					var(--color-accent) 40%,
					var(--color-line-strong)
				);
				background: var(--accent-dim);
			}

			.tag.life {
				color: var(--led-life-ink);
				border-color: color-mix(
					in srgb,
					var(--led-life) 40%,
					var(--color-line-strong)
				);
				background: var(--led-life-dim);
			}

			.feed {
				list-style: none;
				margin: 0;
				padding: 0;
			}

			.entry {
				display: grid;
				grid-template-columns: 152px 1fr;
				gap: 4px 20px;
				padding: 16px 12px;
				border-radius: 9px;
				border: 1px solid transparent;
				transition:
					background var(--transition-fast),
					border-color var(--transition-fast);
			}

			.entry:hover {
				background: var(--color-panel);
				border-color: var(--color-line);
			}

			.entry + .entry {
				border-top: 1px solid var(--color-line);
				border-radius: 9px;
			}

			.entry:hover + .entry,
			.entry:hover {
				border-top-color: transparent;
			}

			.entry .when {
				font-family: var(--font-mono);
				font-size: 12.5px;
				color: var(--color-muted);
				display: flex;
				align-items: center;
				gap: 8px;
				padding-top: 3px;
				font-variant-numeric: tabular-nums;
				white-space: nowrap;
			}

			.entry .body {
				min-width: 0;
			}

			.entry h3 {
				margin: 0 0 6px;
				font-size: 16.5px;
				font-weight: 650;
				line-height: 1.4;
			}

			.entry h3 a {
				color: var(--color-text);
				text-decoration: none;
			}

			.entry:hover h3 a {
				color: var(--color-accent-ink);
			}

			.entry .tags {
				display: flex;
				gap: 7px;
				flex-wrap: wrap;
			}

			@media (max-width: 560px) {
				.entry {
					grid-template-columns: 1fr;
					gap: 8px;
				}

				.entry .when {
					padding-top: 0;
				}
			}
		</style>

		<style>
			.statusbar {
				position: sticky;
				top: 0;
				z-index: 100;
				display: flex;
				align-items: center;
				gap: 16px;
				min-height: var(--nav-height);
				padding: 12px clamp(16px, 4vw, 40px);
				background: color-mix(in srgb, var(--color-bg) 82%, transparent);
				backdrop-filter: blur(10px);
				-webkit-backdrop-filter: blur(10px);
				border-bottom: 1px solid var(--color-line);
				font-family: var(--font-mono);
				font-size: 13px;
			}

			.host {
				display: inline-flex;
				align-items: center;
				gap: 9px;
				font-weight: 600;
				letter-spacing: 0.01em;
				color: var(--color-text);
				text-decoration: none;
				flex: none;
			}

			.host .prompt {
				color: var(--color-muted);
			}

			.host .name {
				color: var(--color-accent-ink);
			}

			/* Status LED — signals "online", ties the homelab concept together */
			.led {
				width: 8px;
				height: 8px;
				border-radius: 50%;
				background: var(--color-accent);
				flex: none;
				animation: led-pulse 2.6s ease-out infinite;
			}

			@keyframes led-pulse {
				0% {
					box-shadow: 0 0 0 0
						color-mix(in srgb, var(--color-accent) 55%, transparent);
				}
				70% {
					box-shadow: 0 0 0 6px transparent;
				}
				100% {
					box-shadow: 0 0 0 0 transparent;
				}
			}

			@media (prefers-reduced-motion: reduce) {
				.led {
					animation: none;
				}
			}

			.status-nav {
				display: flex;
				align-items: center;
				gap: var(--spacing-5);
				flex-wrap: wrap;
				min-width: 0;
			}

			.status-nav a {
				text-decoration: none;
				color: var(--color-text-secondary);
				text-transform: lowercase;
				transition: color var(--transition-fast);
			}

			.status-nav a:hover {
				color: var(--color-accent);
			}

			.status-admin {
				color: var(--color-muted);
			}

			.statusbar .spacer {
				flex: 1;
			}

			.clock {
				color: var(--color-muted);
				font-variant-numeric: tabular-nums;
				white-space: nowrap;
			}

			.clock :global(b) {
				color: var(--color-ink-soft);
				font-weight: 600;
			}

			@media (max-width: 640px) {
				.clock {
					display: none;
				}
			}

			.theme-toggle {
				font-family: var(--font-mono);
				font-size: 12px;
				color: var(--color-muted);
				background: transparent;
				border: 1px solid var(--color-line-strong);
				border-radius: 6px;
				padding: 5px 10px;
				cursor: pointer;
				transition:
					border-color var(--transition-fast),
					color var(--transition-fast);
			}

			.theme-toggle:hover {
				color: var(--color-text);
				border-color: var(--color-accent);
			}

			.theme-toggle:focus-visible {
				outline: 2px solid var(--color-accent);
				outline-offset: 2px;
			}

			main {
				min-height: calc(100vh - var(--nav-height) - 300px);
			}

			/* Footer */
			.foot {
				max-width: var(--wide-width);
				margin: 0 auto;
				padding: var(--spacing-12) clamp(16px, 4vw, 40px) var(--spacing-12);
				font-family: var(--font-mono);
				font-size: 12px;
				color: var(--color-muted);
			}

			.foot .bar {
				height: 1px;
				background: var(--color-line);
				margin-bottom: 18px;
			}

			.foot a {
				color: var(--color-muted);
				text-decoration: underline;
				text-underline-offset: 2px;
			}

			.foot a:hover {
				color: var(--color-text);
			}

			.foot :global(.widget-area) {
				margin-bottom: var(--spacing-6);
			}

			@media (max-width: 640px) {
				.statusbar {
					flex-wrap: wrap;
					row-gap: 8px;
				}

				.status-nav {
					order: 3;
					width: 100%;
				}

				.spacer {
					display: none;
				}
			}
		</style>

		<script>
			// ⌘K / Ctrl+K navigates to the search page (there's no inline search
			// input in the statusbar anymore).
			document.addEventListener("keydown", (e) => {
				if ((e.metaKey || e.ctrlKey) && e.key === "k") {
					const target = e.target;
					if (
						target instanceof HTMLElement &&
						(target.matches("input, textarea, select") ||
							target.isContentEditable)
					) {
						return;
					}
					e.preventDefault();
					window.location.assign("/search");
				}
			});
		</script>
		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
