---
import { getEmDashCollection, getEntryTerms } from "emdash";
import Base from "../../layouts/Base.astro";
import LogEntry from "../../components/LogEntry.astro";
import { comparePublishedDateDesc, getPublishedDate } from "../../utils/post-date";
import { getPostKind } from "../../utils/post-kind";

const { entries: posts, cacheHint } = await getEmDashCollection("posts");

Astro.cache.set(cacheHint);

const sortedPosts = posts.toSorted(comparePublishedDateDesc);

// Category terms per post, fetched in parallel. `post.data.id` is the DB
// ULID (required by getEntryTerms) — `post.id` is just the slug.
const postsTerms = await Promise.all(
	sortedPosts.map((post) => getEntryTerms("posts", post.data.id, "category"))
);
---

<Base title="ログ" description="全記事のアップタイム・ログ">
	<div class="log-page">
		<p class="sec-label">
			ログ <span class="count">// {posts.length} entries</span>
		</p>
		{
			sortedPosts.length === 0 ? (
				<p class="empty">No posts yet.</p>
			) : (
				<ul class="feed">
					{sortedPosts.map((post, i) => {
						const terms = postsTerms[i] ?? [];
						return (
							<LogEntry
								title={post.data.title ?? "Untitled"}
								href={`/posts/${post.id}`}
								date={getPublishedDate(post)}
								terms={terms.map((t) => ({ slug: t.slug, label: t.label }))}
								kind={getPostKind(terms)}
							/>
						);
					})}
				</ul>
			)
		}
	</div>
</Base>

<style>
	.log-page {
		max-width: 820px;
		margin: 0 auto;
		padding: clamp(28px, 5vw, 56px) clamp(16px, 4vw, 40px) 80px;
	}

	.empty {
		color: var(--color-muted);
		font-size: var(--font-size-lg);
	}
</style>
