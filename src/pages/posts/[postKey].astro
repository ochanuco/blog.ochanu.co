---
import {
	getEmDashEntry,
	getEntryTerms,
	getSeoMeta,
	getSiteSettings,
} from "emdash";
import { Image, PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import { getPublishedDate } from "../../utils/post-date";
import { getPostsSummary } from "../../utils/posts-summary";
import { getReadingTime } from "../../utils/reading-time";

const { postKey } = Astro.params;

if (!postKey) {
	return Astro.redirect("/404");
}

const { entry: post, cacheHint } = await getEmDashEntry("posts", postKey);

if (!post) {
	return Astro.redirect("/404");
}

Astro.cache.set(cacheHint);

// Get featured image URL for OG fallback
// The image may have src (external) or meta.storageKey (local)
function getImageUrl(img: unknown): string | undefined {
	if (!img || typeof img !== "object") return undefined;
	const image = img as Record<string, unknown>;
	// Check for direct src
	if (typeof image.src === "string" && image.src) {
		return image.src.startsWith("http")
			? image.src
			: `${Astro.url.origin}${image.src}`;
	}
	// Build from storageKey for local images
	const meta = image.meta as Record<string, unknown> | undefined;
	const storageKey =
		(typeof meta?.storageKey === "string" ? meta.storageKey : undefined) ||
		(typeof image.id === "string" ? image.id : undefined);
	if (storageKey) {
		return `${Astro.url.origin}/_emdash/api/media/file/${storageKey}`;
	}
	return undefined;
}
const featuredImageUrl = getImageUrl(post.data.featured_image);
const settings = await getSiteSettings();
const siteTitle = settings.title || "おちゃぬこさいさい";

// Generate SEO meta from content
const seo = getSeoMeta(post, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: `/posts/${postKey}`,
	defaultOgImage: featuredImageUrl,
});

// Get category + tags for this post
// Note: post.id is the slug, post.data.id is the database ULID
const categoryTerms = await getEntryTerms("posts", post.data.id, "category");
const tags = await getEntryTerms("posts", post.data.id, "tag");
const primaryCategory = categoryTerms[0];

// Bylines are already hydrated by getEmDashEntry
const bylines = post.data.bylines ?? [];

// Get reading time
const readingTime = getReadingTime(post.data.content);

const publishedAt = getPublishedDate(post);

const JST_YMD: Intl.DateTimeFormatOptions = {
	timeZone: "Asia/Tokyo",
	year: "numeric",
	month: "2-digit",
	day: "2-digit",
};
const marginDate = publishedAt
	? new Intl.DateTimeFormat("en-CA", JST_YMD).format(publishedAt).replaceAll("-", ".")
	: null;

// Prev/next navigation: all posts sorted newest-first, current post's
// neighbors in that ordering. p.1 is the newest post; "次のページ" walks
// toward older posts (higher page number), "前のページ" walks back toward
// the newest (lower page number, p.1).
// 全件クエリは共有ストア(短命キャッシュ)から。
const { posts: sortedAll } = await getPostsSummary();
const currentIndex = sortedAll.findIndex((p) => p.slug === post.id);
const pageNumber = currentIndex >= 0 ? currentIndex + 1 : null;
const newerPost = currentIndex > 0 ? sortedAll[currentIndex - 1] : null;
const olderPost =
	currentIndex >= 0 && currentIndex < sortedAll.length - 1
		? sortedAll[currentIndex + 1]
		: null;
---

<Base
	title={seo.title}
	description={seo.description}
	image={seo.ogImage}
	canonical={seo.canonical}
	robots={seo.robots}
	type="article"
	publishedTime={publishedAt?.toISOString() ?? null}
	modifiedTime={post.data.updatedAt.toISOString()}
	content={{ collection: "posts", id: post.data.id, slug: postKey }}
>
	<article class="entry-page notebook-card">
		<header class="entry-head">
			{/* キャンパスノートの表題部: 右上に No. / Date 欄 */}
			<div class="entry-fields">
				{pageNumber && (
					<p class="field">
						<span class="k">No.</span>
						<span class="v">{pageNumber}</span>
					</p>
				)}
				{marginDate && (
					<p class="field">
						<span class="k">Date</span>
						<time class="v" datetime={publishedAt?.toISOString()}>
							{marginDate.replaceAll(".", " . ")}
						</time>
					</p>
				)}
				<p class="entry-sub">
					{primaryCategory && `（${primaryCategory.label}）`} {readingTime} min
					{bylines.length > 0 &&
						` ・ ${bylines.map((c) => c.byline.displayName).join("、")}`}
				</p>
			</div>
			<h1 class="entry-title" {...post.edit.title}>{post.data.title}</h1>
			<div class="entry-title-rule" aria-hidden="true" />
		</header>

		{
			post.data.featured_image && (
				<div class="entry-hero hand-box" {...post.edit.featured_image}>
					<Image image={post.data.featured_image} />
				</div>
			)
		}

		<div class="entry-content ruled-prose ruled-paper">
			<PortableText value={post.data.content} />
		</div>

		{
			tags.length > 0 && (
				<div class="entry-tags">
					{tags.map((t) => (
						<a href={`/tag/${t.slug}`} class="entry-tag">
							#{t.label}
						</a>
					))}
				</div>
			)
		}

		<nav class="entry-nav" aria-label="前後の記事">
			<a
				class:list={["entry-nav-link", "prev", !newerPost && "is-disabled"]}
				href={newerPost ? `/posts/${newerPost.slug}` : undefined}
				aria-disabled={!newerPost}
			>
				← 前のページ
			</a>
			{pageNumber && <span class="entry-page-no">p.{pageNumber}</span>}
			<a
				class:list={["entry-nav-link", "next", !olderPost && "is-disabled"]}
				href={olderPost ? `/posts/${olderPost.slug}` : undefined}
				aria-disabled={!olderPost}
			>
				次のページ →
			</a>
		</nav>
	</article>
</Base>

<style>
	.entry-page {
		max-width: 944px;
		padding: clamp(24px, 4vw, 44px) clamp(16px, 4vw, 36px) 64px;
	}

	.entry-head {
		margin-bottom: 40px;
	}

	/* ノートの表題部: 右上の No. / Date 記入欄 */
	.entry-fields {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 8px;
		margin-bottom: 26px;
	}

	.field {
		display: flex;
		align-items: baseline;
		gap: 12px;
		width: 250px;
		margin: 0;
		padding-bottom: 3px;
		border-bottom: 1.5px solid var(--color-rule);
	}

	.field .k {
		font-size: 13px;
		color: var(--color-muted);
		letter-spacing: 0.06em;
	}

	.field .v {
		font-size: 16px;
		font-weight: 700;
		color: var(--color-red);
		font-variant-numeric: tabular-nums;
	}

	.entry-sub {
		margin: 2px 0 0;
		font-size: 12.5px;
		color: var(--color-muted);
	}

	.entry-title {
		font-size: clamp(24px, 4.5vw, 34px);
		font-weight: 700;
		line-height: 1.4;
		margin: 0 0 10px;
	}

	/* タイトル行: 下に太い実線、その下にドット入りの太罫 */
	.entry-title-rule {
		margin-top: 14px;
		border-top: 2px solid var(--color-rule);
		height: 6px;
		background-image: radial-gradient(
			circle at 10px 4px,
			var(--color-rule) 1.3px,
			transparent 1.6px
		);
		background-size: 20px 6px;
		background-repeat: repeat-x;
	}

	.entry-hero {
		overflow: hidden;
		margin-bottom: 32px;
	}

	.entry-hero :global(img) {
		width: 100%;
		height: auto;
		max-height: 420px;
		object-fit: cover;
	}

	/* Reading area: paper only, no grid — readability over decoration. */
	.entry-content :global(pre) {
		margin: 0 0 32px;
		padding: var(--spacing-5);
		background: var(--color-grid);
		border-radius: var(--radius);
		overflow-x: auto;
		font-family: var(--font-mono);
		font-size: 0.9em;
		line-height: 1.6;
	}

	.entry-content :global(code) {
		font-family: var(--font-mono);
		font-size: 0.9em;
		background: var(--color-grid);
		padding: 0.2em 0.4em;
		border-radius: var(--radius);
	}

	.entry-content :global(pre code) {
		background: none;
		padding: 0;
	}


	.entry-content :global(hr) {
		/* 罫線1行ぶんの位置に引く(ピッチの倍数を維持) */
		margin: calc(var(--pitch, 32px) - 1px) 0 var(--pitch, 32px);
		border: none;
		border-top: 1px solid var(--color-rule);
	}

	.entry-content :global(a) {
		color: var(--color-red);
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.entry-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 10px 14px;
		margin-top: 36px;
		padding-top: 20px;
		border-top: 1px dashed var(--color-rule);
	}

	.entry-tag {
		font-size: 13px;
		color: var(--color-muted);
	}

	.entry-tag:hover {
		color: var(--color-red);
	}

	.entry-nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		margin-top: 28px;
		padding-top: 20px;
		font-size: 13.5px;
	}

	.entry-nav-link {
		color: var(--color-ink);
	}

	.entry-nav-link:hover {
		color: var(--color-red);
	}

	.entry-nav-link.is-disabled {
		color: var(--color-grid);
		pointer-events: none;
	}

	.entry-page-no {
		font-size: 12px;
		color: var(--color-muted);
		font-variant-numeric: tabular-nums;
	}

	@media (max-width: 560px) {
		.field {
			width: 200px;
		}
	}
</style>
