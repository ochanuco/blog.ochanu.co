---
import {
	getEmDashEntry,
	getEmDashCollection,
	getEntryTerms,
	getSeoMeta,
	getSiteSettings,
} from "emdash";
import { Image, PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import { comparePublishedDateDesc, getPublishedDate } from "../../utils/post-date";
import { getReadingTime } from "../../utils/reading-time";

const { postKey } = Astro.params;

if (!postKey) {
	return Astro.redirect("/404");
}

const { entry: post, cacheHint } = await getEmDashEntry("posts", postKey);

if (!post) {
	return Astro.redirect("/404");
}

Astro.cache.set(cacheHint);

// Get featured image URL for OG fallback
// The image may have src (external) or meta.storageKey (local)
function getImageUrl(img: unknown): string | undefined {
	if (!img || typeof img !== "object") return undefined;
	const image = img as Record<string, unknown>;
	// Check for direct src
	if (typeof image.src === "string" && image.src) {
		return image.src.startsWith("http")
			? image.src
			: `${Astro.url.origin}${image.src}`;
	}
	// Build from storageKey for local images
	const meta = image.meta as Record<string, unknown> | undefined;
	const storageKey =
		(typeof meta?.storageKey === "string" ? meta.storageKey : undefined) ||
		(typeof image.id === "string" ? image.id : undefined);
	if (storageKey) {
		return `${Astro.url.origin}/_emdash/api/media/file/${storageKey}`;
	}
	return undefined;
}
const featuredImageUrl = getImageUrl(post.data.featured_image);
const settings = await getSiteSettings();
const siteTitle = settings.title || "おちゃぬこさいさい";

// Generate SEO meta from content
const seo = getSeoMeta(post, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: `/posts/${postKey}`,
	defaultOgImage: featuredImageUrl,
});

// Get category + tags for this post
// Note: post.id is the slug, post.data.id is the database ULID
const categoryTerms = await getEntryTerms("posts", post.data.id, "category");
const tags = await getEntryTerms("posts", post.data.id, "tag");
const primaryCategory = categoryTerms[0];

// Bylines are already hydrated by getEmDashEntry
const bylines = post.data.bylines ?? [];

// Get reading time
const readingTime = getReadingTime(post.data.content);

const publishedAt = getPublishedDate(post);

const JST_YMD: Intl.DateTimeFormatOptions = {
	timeZone: "Asia/Tokyo",
	year: "numeric",
	month: "2-digit",
	day: "2-digit",
};
const marginDate = publishedAt
	? new Intl.DateTimeFormat("en-CA", JST_YMD).format(publishedAt).replaceAll("-", ".")
	: null;

// Prev/next navigation: all posts sorted newest-first, current post's
// neighbors in that ordering. p.1 is the newest post; "次のページ" walks
// toward older posts (higher page number), "前のページ" walks back toward
// the newest (lower page number, p.1).
const { entries: allPosts } = await getEmDashCollection("posts");
const sortedAll = allPosts.toSorted(comparePublishedDateDesc);
const currentIndex = sortedAll.findIndex((p) => p.id === post.id);
const pageNumber = currentIndex >= 0 ? currentIndex + 1 : null;
const newerPost = currentIndex > 0 ? sortedAll[currentIndex - 1] : null;
const olderPost =
	currentIndex >= 0 && currentIndex < sortedAll.length - 1
		? sortedAll[currentIndex + 1]
		: null;
---

<Base
	title={seo.title}
	description={seo.description}
	image={seo.ogImage}
	canonical={seo.canonical}
	robots={seo.robots}
	type="article"
	publishedTime={publishedAt?.toISOString() ?? null}
	modifiedTime={post.data.updatedAt.toISOString()}
	content={{ collection: "posts", id: post.data.id, slug: postKey }}
>
	<article class="entry-page notebook-card">
		<header class="entry-head">
			<div class="entry-margin">
				{
					marginDate && (
						<time class="entry-date" datetime={publishedAt?.toISOString()}>
							{marginDate}
						</time>
					)
				}
				{primaryCategory && <p class="entry-cat">（{primaryCategory.label}）</p>}
				<p class="entry-reading">{readingTime} min</p>
				{
					bylines.length > 0 && (
						<p class="entry-byline">
							{bylines.map((credit, i) => (
								<>
									{i > 0 && "、"}
									{credit.byline.displayName}
								</>
							))}
						</p>
					)
				}
			</div>
			<div class="entry-title-col">
				<h1 class="entry-title" {...post.edit.title}>{post.data.title}</h1>
				{post.data.excerpt && <p class="entry-excerpt">{post.data.excerpt}</p>}
			</div>
		</header>

		{
			post.data.featured_image && (
				<div class="entry-hero hand-box" {...post.edit.featured_image}>
					<Image image={post.data.featured_image} />
				</div>
			)
		}

		<div class="entry-content">
			<PortableText value={post.data.content} />
		</div>

		{
			tags.length > 0 && (
				<div class="entry-tags">
					{tags.map((t) => (
						<a href={`/tag/${t.slug}`} class="entry-tag">
							#{t.label}
						</a>
					))}
				</div>
			)
		}

		<nav class="entry-nav" aria-label="前後の記事">
			<a
				class:list={["entry-nav-link", "prev", !newerPost && "is-disabled"]}
				href={newerPost ? `/posts/${newerPost.id}` : undefined}
				aria-disabled={!newerPost}
			>
				← 前のページ
			</a>
			{pageNumber && <span class="entry-page-no">p.{pageNumber}</span>}
			<a
				class:list={["entry-nav-link", "next", !olderPost && "is-disabled"]}
				href={olderPost ? `/posts/${olderPost.id}` : undefined}
				aria-disabled={!olderPost}
			>
				次のページ →
			</a>
		</nav>
	</article>
</Base>

<style>
	.entry-page {
		max-width: 760px;
		padding: clamp(24px, 4vw, 44px) clamp(16px, 4vw, 36px) 64px;
	}

	.entry-head {
		display: flex;
		gap: 24px;
		align-items: flex-start;
		margin-bottom: 32px;
		padding-bottom: 20px;
		border-bottom: 1.5px solid var(--color-rule);
	}

	.entry-margin {
		flex: none;
		width: 112px;
		text-align: right;
		font-size: 12.5px;
		color: var(--color-muted);
	}

	.entry-date {
		display: block;
		font-variant-numeric: tabular-nums;
		color: var(--color-red);
		font-weight: 600;
		margin-bottom: 4px;
	}

	.entry-cat,
	.entry-reading,
	.entry-byline {
		margin: 2px 0 0;
	}

	.entry-title-col {
		flex: 1;
		min-width: 0;
	}

	.entry-title {
		font-size: clamp(24px, 4.5vw, 34px);
		font-weight: 700;
		line-height: 1.4;
		margin: 0 0 10px;
	}

	.entry-excerpt {
		font-size: 15px;
		color: var(--color-muted);
		margin: 0;
	}

	.entry-hero {
		overflow: hidden;
		margin-bottom: 32px;
	}

	.entry-hero :global(img) {
		width: 100%;
		height: auto;
		max-height: 420px;
		object-fit: cover;
	}

	/* Reading area: paper only, no grid — readability over decoration. */
	.entry-content {
		font-size: 16px;
		line-height: 1.9;
	}

	.entry-content :global(p) {
		margin-bottom: 1.5em;
	}

	.entry-content :global(h2) {
		font-size: 1.5em;
		margin-top: 2em;
		margin-bottom: 0.75em;
	}

	.entry-content :global(h3) {
		font-size: 1.25em;
		margin-top: 1.75em;
		margin-bottom: 0.5em;
	}

	.entry-content :global(blockquote) {
		margin: 2em 0;
		padding: var(--spacing-4) var(--spacing-6);
		border-left: 3px solid var(--color-rule);
		color: var(--color-muted);
		font-style: italic;
	}

	.entry-content :global(pre) {
		margin: 2em 0;
		padding: var(--spacing-5);
		background: var(--color-grid);
		border-radius: var(--radius);
		overflow-x: auto;
		font-family: var(--font-mono);
		font-size: 0.9em;
		line-height: 1.6;
	}

	.entry-content :global(code) {
		font-family: var(--font-mono);
		font-size: 0.9em;
		background: var(--color-grid);
		padding: 0.2em 0.4em;
		border-radius: var(--radius);
	}

	.entry-content :global(pre code) {
		background: none;
		padding: 0;
	}

	.entry-content :global(ul),
	.entry-content :global(ol) {
		margin-bottom: 1.5em;
		padding-left: 1.5em;
	}

	.entry-content :global(li) {
		margin-bottom: 0.5em;
	}

	.entry-content :global(img) {
		margin: 2em 0;
		border-radius: var(--radius-lg);
	}

	.entry-content :global(hr) {
		margin: 3em 0;
		border: none;
		border-top: 1px solid var(--color-rule);
	}

	.entry-content :global(a) {
		color: var(--color-red);
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.entry-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 10px 14px;
		margin-top: 36px;
		padding-top: 20px;
		border-top: 1px dashed var(--color-rule);
	}

	.entry-tag {
		font-size: 13px;
		color: var(--color-muted);
	}

	.entry-tag:hover {
		color: var(--color-red);
	}

	.entry-nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		margin-top: 28px;
		padding-top: 20px;
		font-size: 13.5px;
	}

	.entry-nav-link {
		color: var(--color-ink);
	}

	.entry-nav-link:hover {
		color: var(--color-red);
	}

	.entry-nav-link.is-disabled {
		color: var(--color-grid);
		pointer-events: none;
	}

	.entry-page-no {
		font-size: 12px;
		color: var(--color-muted);
		font-variant-numeric: tabular-nums;
	}

	@media (max-width: 560px) {
		.entry-head {
			flex-direction: column;
			gap: 8px;
		}

		.entry-margin {
			width: auto;
			text-align: left;
			display: flex;
			flex-wrap: wrap;
			gap: 4px 12px;
		}

		.entry-date {
			margin-bottom: 0;
		}

		.entry-cat,
		.entry-reading,
		.entry-byline {
			margin: 0;
		}
	}
</style>
