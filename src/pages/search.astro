---
// SSR の部分一致検索。EmDash 組み込みの FTS5 検索(LiveSearch)は
// unicode61 トークナイザのため日本語クエリを取りこぼすので、
// タイトル・抜粋・本文への substring マッチで検索する。
import { getEmDashCollection, getEntryTerms } from "emdash";
import Base from "../layouts/Base.astro";
import LogEntry from "../components/LogEntry.astro";
import { comparePublishedDateDesc, getPublishedDate } from "../utils/post-date";
import { getPostKind } from "../utils/post-kind";
import { extractText } from "../utils/reading-time";

const query = Astro.url.searchParams.get("q")?.trim() || "";

const { entries: posts, cacheHint } = await getEmDashCollection("posts");

Astro.cache.set(cacheHint);

function matchesQuery(post: (typeof posts)[0], q: string): boolean {
	const lower = q.toLowerCase();
	const title = (post.data.title || "").toLowerCase();
	const excerpt = (post.data.excerpt || "").toLowerCase();
	// Portable Text からプレーンテキストを抽出して照合(_type 等への誤マッチ防止)
	const content = extractText(post.data.content).toLowerCase();
	return (
		title.includes(lower) || excerpt.includes(lower) || content.includes(lower)
	);
}

const results = query
	? posts.filter((post) => matchesQuery(post, query)).toSorted(comparePublishedDateDesc)
	: [];

const resultTerms = await Promise.all(
	results.map((post) => getEntryTerms("posts", post.data.id, "category"))
);
---

<Base
	title={query ? `Search: ${query}` : "Search"}
	description="Search blog posts"
>
	<section class="search-page">
		<p class="sec-label">
			検索 <span class="count">// search</span>
		</p>

		<form method="get" action="/search" class="search-form" role="search">
			<input
				type="search"
				name="q"
				value={query}
				placeholder="Search posts..."
				class="search-input"
				autofocus
			/>
			<button type="submit" class="search-button">search</button>
		</form>

		{
			query && (
				<p class="search-summary">
					{results.length === 0
						? `"${query}" に一致する記事はありません`
						: `"${query}" — ${results.length} ${results.length === 1 ? "entry" : "entries"}`}
				</p>
			)
		}

		{
			results.length > 0 && (
				<ul class="feed">
					{results.map((post, i) => {
						const terms = resultTerms[i] ?? [];
						return (
							<LogEntry
								title={post.data.title ?? "Untitled"}
								href={`/posts/${post.id}`}
								date={getPublishedDate(post)}
								terms={terms.map((t) => ({ slug: t.slug, label: t.label }))}
								kind={getPostKind(terms)}
							/>
						);
					})}
				</ul>
			)
		}

		{!query && <p class="search-hint">キーワードを入力してください。</p>}
	</section>
</Base>

<style>
	.search-page {
		max-width: 720px;
		margin: 0 auto;
		padding: clamp(28px, 5vw, 56px) clamp(16px, 4vw, 40px) 80px;
	}

	.search-form {
		display: flex;
		gap: 10px;
		margin-bottom: 24px;
	}

	.search-input {
		flex: 1;
		font-size: 15px;
		font-family: inherit;
		color: var(--color-text);
		background: var(--color-panel);
		border: 1px solid var(--color-line);
		border-radius: var(--radius-lg);
		padding: 11px 14px;
		transition: border-color var(--transition-base);
	}

	.search-input:focus {
		outline: none;
		border-color: var(--color-accent);
	}

	.search-input::placeholder {
		color: var(--color-muted);
	}

	.search-button {
		font-family: var(--font-mono);
		font-size: 13px;
		color: var(--color-accent-ink);
		background: var(--color-panel);
		border: 1px solid var(--color-line);
		border-radius: var(--radius-lg);
		padding: 0 18px;
		cursor: pointer;
		transition: border-color var(--transition-base);
	}

	.search-button:hover {
		border-color: var(--color-accent);
	}

	.search-summary {
		font-family: var(--font-mono);
		font-size: 13px;
		color: var(--color-muted);
		margin: 0 0 18px;
	}

	.search-hint {
		color: var(--color-muted);
		font-size: 14px;
		margin: 0;
	}
</style>
