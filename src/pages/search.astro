---
// SSR の部分一致検索。EmDash 組み込みの FTS5 検索(LiveSearch)は
// unicode61 トークナイザのため日本語クエリを取りこぼすので、
// タイトル・抜粋・本文への substring マッチで検索する。
import { getEmDashCollection, getEntryTerms } from "emdash";
import Base from "../layouts/Base.astro";
import NotebookList from "../components/NotebookList.astro";
import { comparePublishedDateDesc, getPublishedDate } from "../utils/post-date";
import { extractText } from "../utils/reading-time";

const query = Astro.url.searchParams.get("q")?.trim() || "";

const { entries: posts, cacheHint } = await getEmDashCollection("posts");

Astro.cache.set(cacheHint);

function matchesQuery(post: (typeof posts)[0], q: string): boolean {
	const lower = q.toLowerCase();
	const title = (post.data.title || "").toLowerCase();
	const excerpt = (post.data.excerpt || "").toLowerCase();
	// Portable Text からプレーンテキストを抽出して照合(_type 等への誤マッチ防止)
	const content = extractText(post.data.content).toLowerCase();
	return (
		title.includes(lower) || excerpt.includes(lower) || content.includes(lower)
	);
}

const results = query
	? posts.filter((post) => matchesQuery(post, query)).toSorted(comparePublishedDateDesc)
	: [];

const resultTerms = await Promise.all(
	results.map((post) => getEntryTerms("posts", post.data.id, "category"))
);

const notebookEntries = results.map((post, i) => ({
	slug: post.id,
	title: post.data.title ?? "Untitled",
	date: getPublishedDate(post),
	terms: (resultTerms[i] ?? []).map((t) => ({ slug: t.slug, label: t.label })),
}));
---

<Base
	title={query ? `Search: ${query}` : "Search"}
	description="Search blog posts"
>
	<section class="search-page">
		<span class="tape">検 索</span>

		<form method="get" action="/search" class="search-form" role="search">
			<input
				type="search"
				name="q"
				value={query}
				placeholder="キーワードを入力..."
				class="search-input hand-box"
				autofocus
			/>
			<button type="submit" class="search-button hand-box">search</button>
		</form>

		{
			query && (
				<p class="search-summary">
					{results.length === 0
						? `"${query}" に一致する記事はありません`
						: `"${query}" — ${results.length} entries`}
				</p>
			)
		}

		{results.length > 0 && <NotebookList entries={notebookEntries} />}

		{!query && <p class="search-hint">キーワードを入力してください。</p>}
	</section>
</Base>

<style>
	.search-page {
		max-width: 720px;
		margin: 0;
		padding: clamp(24px, 4vw, 44px) clamp(16px, 4vw, 36px) 56px;
	}

	.search-page .tape {
		display: block;
		width: fit-content;
	}

	.search-form {
		display: flex;
		gap: 10px;
		margin: 20px 0 20px 8px;
	}

	.search-input {
		flex: 1;
		font-size: 15px;
		font-family: var(--font-hand);
		color: var(--color-ink);
		background: var(--color-paper);
		border: 1.5px solid var(--color-rule);
		padding: 10px 14px;
		transition: border-color var(--transition-base);
	}

	.search-input:focus {
		outline: none;
		border-color: var(--color-red);
	}

	.search-input::placeholder {
		color: var(--color-muted);
	}

	.search-button {
		font-family: var(--font-hand);
		font-size: 13px;
		color: var(--color-ink);
		background: var(--color-paper);
		border: 1.5px solid var(--color-rule);
		padding: 0 18px;
		cursor: pointer;
		transition: border-color var(--transition-base);
	}

	.search-button:hover {
		border-color: var(--color-red);
		color: var(--color-red);
	}

	.search-summary {
		font-size: 12.5px;
		color: var(--color-muted);
		margin: 0 0 8px 8px;
	}

	.search-hint {
		color: var(--color-muted);
		font-size: 14px;
		margin: 0 0 0 8px;
	}
</style>
