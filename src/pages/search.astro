---
// 静的検索ページ(Pagefind)。/pagefind/ のインデックスとUIバンドルは
// scripts/generate-static.sh が静的サイト生成時に付与するため、
// SSR(admin ホスト)上では検索は利用できない。
import Base from "../layouts/Base.astro";
---

<Base title="Search" description="Search blog posts">
	<section class="search-page">
		<h1 class="search-title">Search</h1>

		<div id="pagefind-search"></div>

		<p class="search-unavailable" hidden>
			Search is only available on the published site.
		</p>
		<noscript>
			<p class="search-unavailable-noscript">
				Search requires JavaScript to be enabled.
			</p>
		</noscript>
	</section>
</Base>

<link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
<script is:inline>
	(function () {
		var script = document.createElement("script");
		script.src = "/pagefind/pagefind-ui.js";
		script.onload = function () {
			var ui = new window.PagefindUI({
				element: "#pagefind-search",
				showSubResults: true,
				showImages: false,
			});
			var q = new URLSearchParams(location.search).get("q");
			if (q) ui.triggerSearch(q);
		};
		script.onerror = function () {
			var fallback = document.querySelector(".search-unavailable");
			if (fallback) fallback.hidden = false;
		};
		document.head.appendChild(script);
	})();
</script>

<style>
	.search-page {
		max-width: var(--max-width);
		margin: 0 auto;
		padding: var(--spacing-8) var(--spacing-6) var(--spacing-16);
	}

	.search-title {
		font-size: var(--font-size-2xl);
		margin-bottom: var(--spacing-6);
	}

	.search-unavailable,
	.search-unavailable-noscript {
		color: var(--color-muted);
	}

	#pagefind-search {
		--pagefind-ui-primary: var(--color-accent);
		--pagefind-ui-text: var(--color-text);
		--pagefind-ui-background: var(--color-bg);
		--pagefind-ui-border: var(--color-border);
		--pagefind-ui-tag: var(--color-surface);
		--pagefind-ui-border-width: 1px;
		--pagefind-ui-border-radius: var(--radius);
		--pagefind-ui-font: var(--font-sans);
	}
</style>
