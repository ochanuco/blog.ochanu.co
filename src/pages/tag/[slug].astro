---
import { getTerm, getEmDashCollection } from "emdash";
import Base from "../../layouts/Base.astro";
import NotebookList from "../../components/NotebookList.astro";
import { comparePublishedDateDesc } from "../../utils/post-date";
import { toNotebookEntries } from "../../utils/notebook-entries";

const { slug } = Astro.params;
const term = slug ? await getTerm("tag", slug) : null;

if (!term) {
	return Astro.redirect("/404");
}

const { entries: posts, cacheHint } = await getEmDashCollection("posts", {
	where: { tag: term.slug },
});

Astro.cache.set(cacheHint);

const sortedPosts = posts.toSorted(comparePublishedDateDesc);

const notebookEntries = await toNotebookEntries(sortedPosts);
---

<Base
	title={`Posts tagged "${term.label}"`}
	description={`All posts tagged with ${term.label}`}
>
	<div class="archive-page notebook-card">
		<header class="note-head">
			<span class="tape">「{term.label}」の 記 録</span>
			<div class="note-fields">
				<p class="note-field">
					<span class="k">Entries</span>
					<span class="v">{sortedPosts.length}</span>
				</p>
			</div>
		</header>
		<div class="note-rule head-rule" aria-hidden="true" />
		{
			sortedPosts.length === 0 ? (
				<p class="empty">No posts with this tag yet.</p>
			) : (
				<NotebookList entries={notebookEntries} />
			)
		}
	</div>
</Base>

<style>
	.archive-page {
		max-width: 944px;
		padding: clamp(24px, 4vw, 44px) clamp(16px, 4vw, 36px) 56px;
	}

	.archive-page .tape {
		display: block;
		width: fit-content;
	}

	.head-rule {
		margin: 4px 0 0;
	}

	.empty {
		color: var(--color-muted);
		font-size: var(--font-size-lg);
	}
</style>
