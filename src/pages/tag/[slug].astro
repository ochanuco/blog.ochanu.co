---
import { getTerm, getEmDashCollection, getEntryTerms } from "emdash";
import Base from "../../layouts/Base.astro";
import NotebookList from "../../components/NotebookList.astro";
import { comparePublishedDateDesc, getPublishedDate } from "../../utils/post-date";

const { slug } = Astro.params;
const term = slug ? await getTerm("tag", slug) : null;

if (!term) {
	return Astro.redirect("/404");
}

const { entries: posts, cacheHint } = await getEmDashCollection("posts", {
	where: { tag: term.slug },
});

Astro.cache.set(cacheHint);

const sortedPosts = posts.toSorted(comparePublishedDateDesc);

// Category terms per post, fetched in parallel. `post.data.id` is the DB
// ULID (required by getEntryTerms) — `post.id` is just the slug.
const postsTerms = await Promise.all(
	sortedPosts.map((post) => getEntryTerms("posts", post.data.id, "category"))
);

const notebookEntries = sortedPosts.map((post, i) => ({
	slug: post.id,
	title: post.data.title ?? "Untitled",
	date: getPublishedDate(post),
	terms: (postsTerms[i] ?? []).map((t) => ({ slug: t.slug, label: t.label })),
}));
---

<Base
	title={`Posts tagged "${term.label}"`}
	description={`All posts tagged with ${term.label}`}
>
	<div class="archive-page">
		<span class="tape">「{term.label}」の 記 録</span>
		<p class="meta"><b>{sortedPosts.length} entries</b></p>
		{
			sortedPosts.length === 0 ? (
				<p class="empty">No posts with this tag yet.</p>
			) : (
				<NotebookList entries={notebookEntries} />
			)
		}
	</div>
</Base>

<style>
	.archive-page {
		max-width: 860px;
		margin: 0;
		padding: clamp(24px, 4vw, 44px) clamp(16px, 4vw, 36px) 56px;
	}

	.archive-page .tape {
		display: block;
		width: fit-content;
	}

	.meta {
		margin: 0 0 20px 8px;
		font-size: 12px;
		color: var(--color-muted);
		font-variant-numeric: tabular-nums;
	}

	.meta b {
		color: var(--color-red);
		font-weight: 600;
	}

	.empty {
		color: var(--color-muted);
		font-size: var(--font-size-lg);
	}
</style>
