---
import { getTerm, getEmDashCollection } from "emdash";
import Base from "../../layouts/Base.astro";
import NotebookList from "../../components/NotebookList.astro";
import { comparePublishedDateDesc, getPublishedDate } from "../../utils/post-date";

const { slug } = Astro.params;
const term = slug ? await getTerm("category", slug) : null;

if (!term) {
	return Astro.redirect("/404");
}

const { entries: posts, cacheHint } = await getEmDashCollection("posts", {
	where: { category: term.slug },
});

Astro.cache.set(cacheHint);

const sortedPosts = posts.toSorted(comparePublishedDateDesc);

const notebookEntries = sortedPosts.map((post) => ({
	slug: post.id,
	title: post.data.title ?? "Untitled",
	date: getPublishedDate(post),
	// The category is already named in the page's tape/heading, so it isn't
	// repeated per-row here.
	terms: [] as Array<{ slug: string; label: string }>,
}));
---

<Base title={`${term.label} posts`} description={`All posts in ${term.label}`}>
	<div class="archive-page notebook-card">
		<span class="tape">（{term.label}）の 記 録</span>
		<p class="meta"><b>{sortedPosts.length} entries</b></p>
		{
			sortedPosts.length === 0 ? (
				<p class="empty">No posts in this category yet.</p>
			) : (
				<NotebookList entries={notebookEntries} />
			)
		}
	</div>
</Base>

<style>
	.archive-page {
		max-width: 860px;
		padding: clamp(24px, 4vw, 44px) clamp(16px, 4vw, 36px) 56px;
	}

	.archive-page .tape {
		display: block;
		width: fit-content;
	}

	.meta {
		margin: 0 0 20px 8px;
		font-size: 12px;
		color: var(--color-muted);
		font-variant-numeric: tabular-nums;
	}

	.meta b {
		color: var(--color-red);
		font-weight: 600;
	}

	.empty {
		color: var(--color-muted);
		font-size: var(--font-size-lg);
	}
</style>
