---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found">
	<div class="not-found">
		<span class="tape">迷 子</span>
		<h1>404</h1>
		<p>このページは、破って捨てちゃったみたい。</p>
		<a href="/" class="hand-box home-btn">トップに戻る →</a>
	</div>
</Base>

<style>
	.not-found {
		max-width: 560px;
		margin: 0 auto;
		text-align: center;
		padding: clamp(64px, 14vw, 120px) 24px;
	}

	.not-found .tape {
		display: inline-block;
	}

	.not-found h1 {
		font-size: clamp(48px, 10vw, 76px);
		color: var(--color-rule);
		margin: 20px 0 6px;
	}

	.not-found p {
		color: var(--color-muted);
		font-size: 15px;
		margin: 0 0 28px;
	}

	.home-btn {
		display: inline-block;
		border: 1.5px solid var(--color-rule);
		padding: 8px 20px;
		color: var(--color-ink);
		font-size: 14px;
	}

	.home-btn:hover {
		border-color: var(--color-red);
		color: var(--color-red);
		text-decoration: none;
	}
</style>
