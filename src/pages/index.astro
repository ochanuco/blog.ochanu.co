---
import { getEmDashCollection, getSiteSettings } from "emdash";
import Base from "../layouts/Base.astro";
import NotebookList from "../components/NotebookList.astro";
import { toNotebookEntries } from "../utils/notebook-entries";
import { comparePublishedDateDesc, getPublishedDate } from "../utils/post-date";
import { FALLBACK_SITE_TITLE, FALLBACK_SITE_TAGLINE } from "../constants/site";

const { entries: posts, cacheHint } = await getEmDashCollection("posts");
const settings = await getSiteSettings();

Astro.cache.set(cacheHint);

const siteTitle = settings.title || FALLBACK_SITE_TITLE;
const siteTagline = settings.tagline || FALLBACK_SITE_TAGLINE;

const sortedPosts = posts.toSorted(comparePublishedDateDesc);

const notebookEntries = await toNotebookEntries(sortedPosts);

const JST_YEAR: Intl.DateTimeFormatOptions = {
	timeZone: "Asia/Tokyo",
	year: "numeric",
};
const getJstYear = (date: Date) =>
	new Intl.DateTimeFormat("en-US", JST_YEAR).format(date);

const dates = sortedPosts.map(getPublishedDate).filter((d): d is Date => d !== null);
const newestYear = dates.length > 0 ? getJstYear(dates[0]) : null;
const oldestYear = dates.length > 0 ? getJstYear(dates[dates.length - 1]) : null;
---

<Base title={siteTitle} description={siteTagline}>
	{
		posts.length === 0 ? (
			<div class="empty-wrap notebook-card">
				<h1 class="visually-hidden">{siteTitle}</h1>
				<span class="tape">作 業 記 録</span>
				<section class="empty-state">
					<h2>No posts yet</h2>
					<p>Create your first post in the admin panel.</p>
					<a href="/_emdash/admin/content/posts/new" class="btn">
						Create a post
					</a>
				</section>
			</div>
		) : (
			<>
			<div class="page notebook-card">
				<header class="site-head note-head">
					<h1 class="visually-hidden">{siteTitle}</h1>
					<span class="tape">作 業 記 録</span>
					<div class="note-fields">
						<p class="note-field">
							<span class="k">Entries</span>
							<span class="v">{posts.length}</span>
						</p>
						{oldestYear && newestYear && (
							<p class="note-field">
								<span class="k">Year</span>
								<span class="v">
									{oldestYear === newestYear
										? oldestYear
										: `${oldestYear} – ${newestYear}`}
								</span>
							</p>
						)}
					</div>
				</header>
				<div class="note-rule head-rule" aria-hidden="true" />

				<NotebookList entries={notebookEntries} highlightFirst />

				<footer class="page-foot">
					<div class="doodle" aria-hidden="true">
						<span class="box">RTX830</span>
						<span class="wire">──→</span>
						<span class="box">New Relic</span>
					</div>
					<div>
						<a href="/search">search</a> · <a href="/rss.xml">rss</a> · <span>p.1</span>
					</div>
				</footer>
			</div>
		</>
		)
	}
</Base>

<style>
	.page {
		/* ノートカードにはリストだけ。グラフは机の上(カードの外)に置く */
		max-width: 944px;
		padding: 24px clamp(20px, 4vw, 44px) 48px;
	}

	.site-head {
		padding: 0 0 0 8px;
	}

	.page-foot {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 18px;
		padding-top: 20px;
		font-size: 12px;
		color: var(--color-muted);
		font-variant-numeric: tabular-nums;
	}

	.page-foot a {
		color: inherit;
		text-decoration: none;
	}

	.page-foot a:hover {
		color: var(--color-red);
	}

	@media (max-width: 800px) {
		.cols {
			display: block;
		}
	}

	@media (max-width: 640px) {
		.page {
			padding: 28px 14px 40px;
		}

		.site-head {
			flex-direction: column;
			align-items: flex-start;
		}

		.site-head .meta {
			text-align: left;
		}
	}

	/* Empty state */
	.empty-wrap {
		max-width: 720px;
		padding: clamp(28px, 5vw, 56px) clamp(16px, 4vw, 40px) 80px;
	}

	.empty-wrap h1 {
		font-size: clamp(28px, 5vw, 38px);
		margin: 0 0 10px;
	}

	.empty-wrap .tagline {
		color: var(--color-muted);
		margin: 0;
	}

	.empty-state {
		margin-top: 40px;
		text-align: center;
		padding: var(--spacing-16) var(--spacing-6);
	}

	.empty-state h2 {
		font-size: var(--font-size-2xl);
		font-weight: 600;
	}

	.empty-state p {
		color: var(--color-muted);
	}

	.btn {
		display: inline-block;
		margin-top: var(--spacing-4);
		padding: var(--spacing-3) var(--spacing-6);
		background: var(--color-red);
		color: #ffffff;
		text-decoration: none;
		border-radius: var(--radius);
		font-size: var(--font-size-sm);
		font-weight: 500;
	}
</style>
