---
import {
	getEmDashCollection,
	getEntryTerms,
	getSiteSettings,
	getTaxonomyTerms,
} from "emdash";
import Base from "../layouts/Base.astro";
import LogEntry from "../components/LogEntry.astro";
import {
	comparePublishedDateDesc,
	formatPublishedDate,
	getPublishedDate,
} from "../utils/post-date";
import { getPostKind } from "../utils/post-kind";
import { FALLBACK_SITE_TITLE, FALLBACK_SITE_TAGLINE } from "../constants/site";

const { entries: posts, cacheHint } = await getEmDashCollection("posts");
const settings = await getSiteSettings();
const categoryTerms = await getTaxonomyTerms("category");

Astro.cache.set(cacheHint);

const siteTitle = settings.title || FALLBACK_SITE_TITLE;
const siteTagline = settings.tagline || FALLBACK_SITE_TAGLINE;

const sortedPosts = posts.toSorted(comparePublishedDateDesc);
const latestPost = sortedPosts[0];
const feedPosts = sortedPosts.slice(1, 11);
const oldestPost = sortedPosts[sortedPosts.length - 1];

const latestDate = getPublishedDate(latestPost);
const oldestDate = getPublishedDate(oldestPost);

// Category terms per post, fetched in parallel. `post.data.id` is the DB
// ULID (required by getEntryTerms) — `post.id` is just the slug.
const latestTerms = latestPost
	? await getEntryTerms("posts", latestPost.data.id, "category")
	: [];
const feedTerms = await Promise.all(
	feedPosts.map((post) => getEntryTerms("posts", post.data.id, "category"))
);

const latestKind = getPostKind(latestTerms);

const uptimeSince = oldestDate ? formatPublishedDate(oldestDate)?.slice(0, 4) : null;
const lastPushDate = latestDate ? formatPublishedDate(latestDate)?.slice(0, 10) : null;
---

<Base title={siteTitle} description={siteTagline}>
	{
		posts.length === 0 ? (
			<div class="empty-wrap">
				<div class="masthead">
					<p class="kicker">homelab · aquarium · notes</p>
					<h1>{siteTitle}</h1>
					<p>{siteTagline}</p>
				</div>
				<section class="empty-state">
					<h2>No posts yet</h2>
					<p>Create your first post in the admin panel.</p>
					<a href="/_emdash/admin/content/posts/new" class="btn">
						Create a post
					</a>
				</section>
			</div>
		) : (
			<div class="wrap">
				<main>
					<div class="masthead">
						<p class="kicker">homelab · aquarium · notes</p>
						<h1>{siteTitle}</h1>
						<p>{siteTagline}</p>
					</div>

					{latestPost && (
						<>
							<p class="sec-label">
								最新 <span class="count">// latest</span>
							</p>
							<a class="current" href={`/posts/${latestPost.id}`}>
								<div class="meta">
									<span class={`dot ${latestKind}`} aria-hidden="true" />
									{latestDate && (
										<time class="ts" datetime={latestDate.toISOString()}>
											{formatPublishedDate(latestDate)}
										</time>
									)}
									{latestTerms.map((term) => (
										<span class={`tag ${latestKind}`}>{term.label}</span>
									))}
								</div>
								<h2>{latestPost.data.title}</h2>
								{latestPost.data.excerpt && <p>{latestPost.data.excerpt}</p>}
							</a>
						</>
					)}

					<p class="sec-label">
						ログ <span class="count">// {posts.length} entries</span>
					</p>
					<ul class="feed">
						{feedPosts.map((post, i) => {
							const terms = feedTerms[i] ?? [];
							return (
								<LogEntry
									title={post.data.title ?? "Untitled"}
									href={`/posts/${post.id}`}
									date={getPublishedDate(post)}
									terms={terms.map((t) => ({ slug: t.slug, label: t.label }))}
									kind={getPostKind(terms)}
								/>
							);
						})}
					</ul>
					<a class="all-entries" href="/posts">
						all entries →
					</a>
				</main>

				<aside class="rail">
					<div class="panel">
						<h4>system</h4>
						<div class="stat-row">
							<span class="k">uptime</span>
							<span class="v accent">{uptimeSince ? `since ${uptimeSince}` : "—"}</span>
						</div>
						<div class="stat-row">
							<span class="k">entries</span>
							<span class="v">{posts.length}</span>
						</div>
						<div class="stat-row">
							<span class="k">last push</span>
							<span class="v">{lastPushDate ?? "—"}</span>
						</div>
						<div class="stat-row">
							<span class="k">runtime</span>
							<span class="v">CF Workers</span>
						</div>
					</div>

					<div class="panel">
						<h4>tags</h4>
						<div class="taglist">
							{categoryTerms.map((term) => (
								<a
									href={`/category/${term.slug}`}
									class={`tag ${getPostKind([term])}`}
								>
									{term.label}
								</a>
							))}
						</div>
					</div>

					<div class="panel">
						<h4>legend</h4>
						<div class="legend">
							<span class="li">
								<span class="dot tech" aria-hidden="true" />
								<span>いじった記録</span>
								<span class="k">tech</span>
							</span>
							<span class="li">
								<span class="dot life" aria-hidden="true" />
								<span>水槽と人生</span>
								<span class="k">life</span>
							</span>
						</div>
					</div>
				</aside>
			</div>
		)
	}
</Base>

<style>
	.wrap {
		max-width: 1080px;
		margin: 0 auto;
		padding: clamp(28px, 5vw, 56px) clamp(16px, 4vw, 40px) 80px;
		display: grid;
		grid-template-columns: 1fr 260px;
		gap: clamp(28px, 5vw, 56px);
		align-items: start;
	}

	@media (max-width: 800px) {
		.wrap {
			grid-template-columns: 1fr;
			gap: 40px;
		}
	}

	/* Masthead */
	.masthead {
		margin-bottom: 34px;
	}

	.masthead h1 {
		font-size: clamp(30px, 5vw, 44px);
		line-height: 1.12;
		letter-spacing: -0.01em;
		margin: 0 0 12px;
		text-wrap: balance;
		font-weight: 800;
	}

	.masthead p {
		margin: 0;
		max-width: 46ch;
		color: var(--color-muted);
		font-size: 15px;
	}

	.masthead .kicker {
		font-family: var(--font-mono);
		font-size: 12px;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--color-accent-ink);
		margin: 0 0 14px;
		display: flex;
		align-items: center;
		gap: 8px;
	}

	.masthead .kicker::before {
		content: "";
		width: 22px;
		height: 1px;
		background: var(--color-accent);
	}

	/* Featured / current card */
	.current {
		display: block;
		background: var(--color-panel);
		border: 1px solid var(--color-line);
		border-radius: 12px;
		padding: 22px 24px;
		box-shadow: var(--shadow-card);
		margin-bottom: 40px;
		text-decoration: none;
		color: inherit;
		transition:
			border-color var(--transition-base),
			transform var(--transition-base);
	}

	.current:hover {
		border-color: var(--color-accent);
		transform: translateY(-2px);
	}

	.current:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 3px;
	}

	.current .meta {
		font-family: var(--font-mono);
		font-size: 12.5px;
		color: var(--color-muted);
		display: flex;
		align-items: center;
		gap: 12px;
		flex-wrap: wrap;
		margin-bottom: 12px;
	}

	.current .ts {
		font-variant-numeric: tabular-nums;
		color: var(--color-ink-soft);
	}

	.current h2 {
		font-size: clamp(20px, 3vw, 26px);
		line-height: 1.28;
		margin: 0 0 10px;
		text-wrap: balance;
		font-weight: 700;
	}

	.current p {
		margin: 0;
		color: var(--color-ink-soft);
		font-size: 15px;
		max-width: 60ch;
	}

	.all-entries {
		display: inline-block;
		margin-top: 16px;
		font-family: var(--font-mono);
		font-size: 13px;
		color: var(--color-accent-ink);
		text-decoration: none;
	}

	.all-entries:hover {
		text-decoration: underline;
	}

	/* Instrument rail */
	.rail {
		display: flex;
		flex-direction: column;
		gap: 28px;
		position: sticky;
		top: calc(var(--nav-height) + 10px);
	}

	@media (max-width: 800px) {
		.rail {
			position: static;
		}
	}

	.panel {
		background: var(--color-panel);
		border: 1px solid var(--color-line);
		border-radius: 12px;
		padding: 18px;
	}

	.panel h4 {
		font-family: var(--font-mono);
		font-size: 11px;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-muted);
		margin: 0 0 14px;
	}

	.stat-row {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		padding: 7px 0;
		border-bottom: 1px dashed var(--color-line);
		font-size: 13px;
	}

	.stat-row:last-child {
		border-bottom: none;
	}

	.stat-row .k {
		color: var(--color-muted);
		font-family: var(--font-mono);
		font-size: 12px;
	}

	.stat-row .v {
		color: var(--color-text);
		font-family: var(--font-mono);
		font-weight: 600;
		font-variant-numeric: tabular-nums;
	}

	.stat-row .v.accent {
		color: var(--color-accent-ink);
	}

	.taglist {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}

	.legend {
		display: flex;
		flex-direction: column;
		gap: 9px;
	}

	.legend .li {
		display: flex;
		align-items: center;
		gap: 9px;
		font-size: 12.5px;
		color: var(--color-ink-soft);
	}

	.legend .li .k {
		font-family: var(--font-mono);
		color: var(--color-muted);
		font-size: 12px;
	}

	/* Empty state */
	.empty-wrap {
		max-width: 1080px;
		margin: 0 auto;
		padding: clamp(28px, 5vw, 56px) clamp(16px, 4vw, 40px) 80px;
	}

	.empty-state {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--spacing-3);
		text-align: center;
		padding: var(--spacing-20) var(--spacing-6);
		max-width: 400px;
		margin: 0 auto;
	}

	.empty-state h2 {
		font-size: var(--font-size-2xl);
		font-weight: 600;
	}

	.empty-state p {
		color: var(--color-muted);
	}

	.btn {
		display: inline-block;
		margin-top: var(--spacing-4);
		padding: var(--spacing-3) var(--spacing-6);
		background: var(--color-accent);
		color: var(--color-on-accent);
		text-decoration: none;
		border-radius: var(--radius);
		font-size: var(--font-size-sm);
		font-weight: 500;
		transition: background var(--transition-fast);
	}

	.btn:hover {
		background: var(--color-accent-hover);
	}
</style>
